// Production. scripts/setup-cloudflare.sh production creates the resources and prints the ids to
// fill in below; `wrangler deploy --dry-run` does not need real ids. Secrets: run
// scripts/launch-secrets.sh production for the list and what is still missing.
// Deployed only by .github/workflows/deploy.yml after the manual approval (spec 1.4, 11.2).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vzc-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "routes": [{ "pattern": "api.videozombiecouple.com", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "KV", "id": "6dbebd4f0fc24c55a63308827c4facef" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vzc",
      "database_id": "f15134d9-1016-4d34-98b7-4fa16c159e6f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "vzc" }],
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "DISPATCHER", "class_name": "Dispatcher" },
      { "name": "STORY_RUNNER", "class_name": "StoryRunner" },
      { "name": "WALLET", "class_name": "Wallet" },
      { "name": "COMPOSER", "class_name": "Composer" }
    ]
  },
  "exports": {
    "RateLimiter": { "type": "durable-object", "storage": "sqlite" },
    "Dispatcher": { "type": "durable-object", "storage": "sqlite" },
    "StoryRunner": { "type": "durable-object", "storage": "sqlite" },
    "Wallet": { "type": "durable-object", "storage": "sqlite" },
    "Composer": { "type": "durable-object", "storage": "sqlite" }
  },
  // Spec §3: apps/composer (ffmpeg + face scoring); scales to zero when idle.
  "containers": [
    {
      "class_name": "Composer",
      "image": "../composer/Dockerfile",
      "max_instances": 3,
      "instance_type": "standard-1"
    }
  ],
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@videozombiecouple.com"] }
  ],
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "vzc_attempts" }],
  // Spec 8.2: every 5 minutes, hourly, daily (03:30 UTC) and weekly (Monday 04:00 UTC).
  "triggers": { "crons": ["*/5 * * * *", "0 * * * *", "30 3 * * *", "0 4 * * 1"] },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGIN": "https://videozombiecouple.com",
    "API_ORIGIN": "https://api.videozombiecouple.com",
    "COOKIE_DOMAIN": ".videozombiecouple.com",
    "TURNSTILE_HOSTNAME": "videozombiecouple.com",
    "R2_ACCOUNT_ID": "4b2e7a7b095a410bd4bbc63a23698cdf",
    "R2_BUCKET_NAME": "vzc",
    "EMAIL_FROM": "VideoZombieCouple <no-reply@videozombiecouple.com>",
    "GOOGLE_CLIENT_ID": "876510837060-62rgai18m99a6ofgs4rvricmd19pc42u.apps.googleusercontent.com",
    // From scripts/stripe-setup.ts live (account acct_1UQlpkK1NmwsUaE9, Managed Payments).
    "STRIPE_PRICES": "{\"pack1\":\"price_1UQnnqK1NmwsUaE9mUjtXQMA\",\"pack3\":\"price_1UQnnrK1NmwsUaE9WRdwtlrv\",\"pack5\":\"price_1UQnnsK1NmwsUaE9DIU0cssX\"}",
    "GA4_MEASUREMENT_ID": "G-PHDSR4556T"
  }
}
