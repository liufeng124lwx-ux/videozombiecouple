{
  "name": "@vzc/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm vendor && astro dev",
    "build": "pnpm vendor && astro build",
    "build:production": "pnpm vendor && PUBLIC_DEPLOY_ENV=production astro build",
    "check:dist": "tsx scripts/check-dist.ts",
    "verify": "pnpm build:production && pnpm check:dist && pnpm size && pnpm build && pnpm check:dist --preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "size": "size-limit",
    "browser-check": "pnpm build && tsx scripts/browser-check.ts",
    "vendor": "tsx scripts/vendor.ts",
    "e2e": "tsx scripts/e2e.ts",
    "lighthouse": "tsx scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/preact": "4.1.3",
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource/archivo": "5.2.8",
    "@fontsource/cormorant-garamond": "5.2.11",
    "@fontsource/courier-prime": "5.2.8",
    "@mediapipe/tasks-vision": "1.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/browser": "10.75.3",
    "@vzc/catalog": "workspace:*",
    "@vzc/contracts": "workspace:*",
    "@vzc/i18n": "workspace:*",
    "astro": "5.18.2",
    "preact": "10.26.4",
    "satori": "0.33.5",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@fontsource/archivo-narrow": "5.2.8",
    "@size-limit/file": "14.0.0",
    "@testing-library/preact": "3.2.4",
    "chrome-launcher": "1.2.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "lighthouse": "13.5.0",
    "playwright": "1.58.2",
    "size-limit": "14.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
