[
  {
    "name": "story tool island (first screen of home and landing pages)",
    "path": "dist/_astro/StoryTool.*.js",
    "limit": "9 kB",
    "gzip": true
  },
  {
    "name": "hero film (first screen of home and landing pages)",
    "path": "dist/_astro/HeroFilm.*.js",
    "limit": "1.5 kB",
    "gzip": true
  },
  {
    "name": "film gallery",
    "path": "dist/_astro/FilmGallery.*.js",
    "limit": "1 kB",
    "gzip": true
  },
  {
    "name": "error catcher (every page)",
    "path": "dist/_astro/BaseLayout.astro_astro_type_script_index_0_lang.*.js",
    "limit": "1 kB",
    "gzip": true
  },
  {
    "name": "shared strings and helpers",
    "path": ["dist/_astro/index.*.js", "dist/_astro/jsxRuntime.module.*.js"],
    "limit": "14 kB",
    "gzip": true
  },
  {
    "name": "pack rows",
    "path": "dist/_astro/PackRows.*.js",
    "limit": "2 kB",
    "gzip": true
  },
  {
    "name": "face detector (loads after a photo is picked)",
    "path": "dist/_astro/vision_bundle.*.js",
    "limit": "50 kB",
    "gzip": true
  },
  {
    "name": "styles (one stylesheet per page group)",
    "path": "dist/_astro/*.css",
    "limit": "12 kB",
    "gzip": true
  }
]
