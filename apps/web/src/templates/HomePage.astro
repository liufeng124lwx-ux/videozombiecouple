---
import "../styles/story.css";
import "../styles/home.css";
import "../styles/pricing.css";
import { type CollectionEntry, render } from "astro:content";
import { type LocaleId, storyPage } from "@vzc/catalog";
import { t } from "@vzc/i18n";
import F from "../components/F.astro";
import Faq from "../components/Faq.astro";
import FilmWall from "../components/FilmWall.tsx";
import HeroFilm from "../components/HeroFilm.tsx";
import PackRows from "../components/pricing/PackRows.tsx";
import { pageContent } from "../lib/content.ts";
import { BUILD_NOW, homeHero, wallTiles } from "../lib/home.ts";
import { sampleImage } from "../lib/sample-images.ts";
import { filmMemory, filmPoster, filmSrc, samplePair } from "../lib/samples.ts";
import { storyBeats, storySamples } from "../lib/story-landing.ts";

interface Props {
  locale: LocaleId;
  h1: string;
  entry: CollectionEntry<"pages">;
}
/**
 * The home page (showcase spec §4): the featured story's film and one button to its page, then a
 * wall with every film we make. The tool lives on each story's page, not here.
 */
const { locale, h1, entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Build time decides the featured story (catalog FEATURED); the switch needs a rebuild on its date.
const hero = homeHero(BUILD_NOW);
const film = hero.film;
const POSTER_SIZES = "(min-width: 900px) 380px, 86vw";
const heroPoster = await sampleImage(filmPoster(film.id), POSTER_SIZES, [540]);
const backdrop = await sampleImage(filmPoster(film.id), "100vw", [360]);
const heroLabel =
  storySamples(hero.story).find((s) => s.film.id === film.id)?.alt ??
  `AI example: ${samplePair(film.pair)?.who ?? ""}`;
// Another story's beats come from its own page's copy; absent, HeroFilm shows the zombie film's.
const featuredPage = storyPage(hero.story);
const featuredEntry =
  hero.story !== "zombie" && featuredPage ? await pageContent(featuredPage, locale, false) : null;
const heroBeats = featuredEntry?.data.beats
  ? storyBeats(hero.story).map((beat, i) => ({
      label: featuredEntry.data.beats?.[i]?.title ?? "",
      from: beat.start,
    }))
  : undefined;

const WALL_SIZES = "(min-width: 900px) 240px, 44vw";
const wall = await Promise.all(
  wallTiles().map(async (tile) => ({
    ...tile,
    poster: (await sampleImage(filmMemory(tile.id), WALL_SIZES, [360])).src,
  })),
);
// The packs that pay for the featured story's film. Sign-in and checkout come back to /pricing,
// which seeds its pick from ?buy= and continues the purchase (landing pages would drop ?buy=).
const packStory = hero.story === "zombie" ? undefined : hero.story;
---
<section class="hero onesheet" aria-label={h1}>
  <div class="onesheet-backdrop" aria-hidden="true">
    <img src={backdrop.src} alt="" width="360" height="640" decoding="async" fetchpriority="low" />
  </div>
  <div class="wrap onesheet-grid">
    <div class="onesheet-copy">
      <p class="onesheet-kicker">{hero.eyebrow}</p>
      <h1 class="onesheet-title">{h1}</h1>
      <p class="onesheet-rule" aria-hidden="true"><span></span></p>
      <p class="lede">{hero.subtitle}</p>
      <div class="onesheet-actions">
        <a class="btn btn-primary btn-lg" href={hero.href}>{hero.cta}</a>
      </div>
      {
        d.trust && (
          <ul class="trust">
            {d.trust.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
    </div>
    <figure class="onesheet-film">
      <HeroFilm
        client:load
        src={filmSrc(film.id)}
        poster={heroPoster.src}
        label={heroLabel}
        {...(heroBeats ? { beats: heroBeats } : {})}
      />
    </figure>
  </div>
</section>

<section class="films now-showing" id="films">
  <div class="wrap">
    <p class="scene">{t("home.wall.kicker", {}, locale)} · {wall.length}</p>
    <h2>{t("home.wall.title", {}, locale)}</h2>
    <p class="small muted">{t("home.wall.text", {}, locale)}</p>
    <FilmWall client:visible tiles={wall} />
  </div>
</section>

{
  d.steps && (
    <section class="section steps-section">
      <div class="wrap">
        <h2>{t("home.steps.title", {}, locale)}</h2>
        <ol class="steps">
          {d.steps.map((step, i) => (
            <li>
              <span class="step-n scene">{`0${i + 1}`}</span>
              <div>
                <h3>{step.title}</h3>
                <p class="muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<section class="section pricing-band">
  <div class="wrap pricing-grid">
    <div>
      <p class="scene">INT. BOX OFFICE — NIGHT</p>
      <h2>{t("home.pricing.title", {}, locale)}</h2>
      <p class="lede">{t("home.pricing.text", {}, locale)}</p>
      <a href="/pricing">{t("home.pricing.more", {}, locale)}</a>
    </div>
    <PackRows client:visible returnPath="/pricing" {...(packStory ? { story: packStory } : {})} />
  </div>
</section>

<section class="section">
  <div class="wrap prose long-read" data-fold>
    <Content components={{ F }} />
  </div>
  <div class="wrap fold-more">
    <button type="button" class="btn btn-lg btn-line" data-unfold>{t("home.readMore", {}, locale)}</button>
  </div>
  <noscript><style>.long-read[data-fold]{max-height:none;mask-image:none}.fold-more{display:none}</style></noscript>
</section>

<script>
  import { wireFolds } from "../lib/fold.ts";
  wireFolds();
</script>

{
  d.faq && d.faq.length > 0 && (
    <section class="section faq-section">
      <div class="wrap">
        <h2>{t("home.faq.title", {}, locale)}</h2>
        <Faq items={d.faq} />
      </div>
    </section>
  )
}
