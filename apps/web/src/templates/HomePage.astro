---
import "../styles/story.css";
import "../styles/home.css";
import "../styles/pricing.css";
import { type CollectionEntry, render } from "astro:content";
import { fact, type LocaleId, type PageConfig, SCENES } from "@vzc/catalog";
import { t } from "@vzc/i18n";
import F from "../components/F.astro";
import Faq from "../components/Faq.astro";
import FilmGallery from "../components/FilmGallery.tsx";
import HeroFilm from "../components/HeroFilm.tsx";
import PackRows from "../components/pricing/PackRows.tsx";
import StoryTool from "../components/story/StoryTool.tsx";
import { sampleImage } from "../lib/sample-images.ts";
import {
  filmLoop,
  filmMemory,
  filmPoster,
  filmSrc,
  HERO_PAIR,
  SAMPLE_FILMS,
  SAMPLE_PAIRS,
  sampleAlt,
  sampleFile,
  samplePair,
} from "../lib/samples.ts";

interface Props {
  locale: LocaleId;
  h1: string;
  page: PageConfig;
  entry: CollectionEntry<"pages">;
  /** home: every section · landing: the trend page, fewer sections. */
  variant: "home" | "landing";
}
const { locale, h1, page, entry, variant } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const hero = samplePair(d.hero ?? HERO_PAIR) ?? SAMPLE_PAIRS[0];
if (!hero) throw new Error("no sample pair");

const POSTER_SIZES = "(min-width: 900px) 380px, 86vw";
const heroFilm = SAMPLE_FILMS.find((f) => f.id === (d.film ?? "cabin")) ?? SAMPLE_FILMS[0];
if (!heroFilm) throw new Error("no sample film");
const heroPoster = await sampleImage(filmPoster(heroFilm.id), POSTER_SIZES, [540]);
const filmPairInfo = samplePair(heroFilm.pair);
const GALLERY_SIZES = "(min-width: 900px) 260px, 44vw";
const gallery = await Promise.all(
  SAMPLE_FILMS.map(async (f) => ({
    id: f.id,
    src: filmSrc(f.id),
    poster: (await sampleImage(filmMemory(f.id), GALLERY_SIZES, [360])).src,
    scene: f.kind === "pet" ? `${SCENES[f.scene].label} · pet` : SCENES[f.scene].label,
    who: `AI example: ${samplePair(f.pair)?.who ?? ""}`,
  })),
);
const petPoster = await sampleImage(filmMemory("pet"), "(min-width: 900px) 300px, 70vw", [360]);
// Scene picker: each scene's poster frame and its silent loop around the match cut.
const posters = Object.fromEntries(
  await Promise.all(
    SAMPLE_FILMS.filter((f) => f.kind === "human").map(async (f) => [
      f.scene,
      { still: (await sampleImage(filmPoster(f.id), "120px", [240])).src, clip: filmLoop(f.id) },
    ]),
  ),
);
const BEAT_SIZES = "(min-width: 900px) 300px, 62vw";
const beats = await Promise.all(
  (["A", "B", "C"] as const).map((f) => sampleImage(sampleFile(hero.id, f), BEAT_SIZES)),
);
const likenessPairs = SAMPLE_PAIRS.filter((p) => p.id !== hero.id).slice(0, 3);
const ROW_SIZES = "(min-width: 900px) 220px, 30vw";
const likeness = await Promise.all(
  likenessPairs.map(async (pair) => ({
    pair,
    survivor: await sampleImage(sampleFile(pair.id, "survivor"), ROW_SIZES, [240, 360]),
    infected: await sampleImage(sampleFile(pair.id, "infected"), ROW_SIZES, [240, 360]),
    a: await sampleImage(sampleFile(pair.id, "A"), ROW_SIZES, [240, 360]),
    c: await sampleImage(sampleFile(pair.id, "C"), ROW_SIZES, [240, 360]),
  })),
);
const preset = page.preset ?? {};
// The title flanks the film: its first word on the left, the rest on the right (design lock A).
const [titleLeft = "", ...rest] = h1.split(" ");
const titleRight = rest.join(" ");
---
<section class="hero premiere" aria-label={h1}>
  <div class="premiere-stage">
    <h1 class="premiere-title">
      <span class="pt-left">{titleLeft}</span>
      {" "}
      <span class="pt-right">{titleRight}</span>
    </h1>
    <figure class="premiere-film">
      <HeroFilm
        client:load
        src={filmSrc(heroFilm.id)}
        poster={heroPoster.src}
        label={`Example film: ${filmPairInfo?.who ?? ""}`}
      />
    </figure>
    <div class="premiere-actions">
      <a class="btn btn-primary btn-lg" href="#make">{t("home.cta", {}, locale)}</a>
      <a class="btn btn-lg btn-line" href="#film">{t("home.watch", {}, locale)}</a>
    </div>
  </div>
  <div class="wrap premiere-credits">
    {d.scene && <p class="scene">{d.scene}</p>}
    {d.lede && <p class="lede">{d.lede}</p>}
    {
      d.trust && (
        <ul class="trust">
          {d.trust.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<section class="make" id="make" aria-label={t("home.makeLabel", {}, locale)}>
  <div class="wrap">
    <StoryTool client:load posters={posters} preset={preset} />
  </div>
</section>

<section class="films now-showing" id="film">
  <div class="wrap showing-grid">
    <div class="showing-rail">
      <p class="scene">{t("home.film.kicker", {}, locale)} · {gallery.length}</p>
      <h2>{t("home.films.title", {}, locale)}</h2>
      <p class="small muted">{t("home.films.text", {}, locale)}</p>
    </div>
    <FilmGallery client:visible films={gallery} />
  </div>
</section>


{
  d.beats && (
    <section class="section beats-section">
      <div class="wrap">
        <p class="scene">{t("home.beats.kicker", {}, locale)}</p>
        <h2>{t("home.beats.title", { seconds: fact("video.seconds") }, locale)}</h2>
      </div>
      <ol class="filmstrip">
        {d.beats.map((beat, i) => (
          <li class={`beat beat-${i + 1}`}>
            <img
              src={beats[i]?.src}
              srcset={beats[i]?.srcset}
              sizes={BEAT_SIZES}
              width="720"
              height="1280"
              alt={sampleAlt(hero, (["A", "B", "C"] as const)[i] ?? "A")}
              loading="lazy"
              decoding="async"
            />
            <p class="scene">{`SC. ${i + 1}`}</p>
            <h3>{beat.title}</h3>
            <p class="small muted">{beat.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

{
  variant === "home" && d.likeness && (
    <section class="section likeness">
      <div class="wrap">
        <h2>{d.likeness.title}</h2>
        <p class="lede">{d.likeness.text}</p>
        <div class="likeness-rows">
          {likeness.map((row) => (
            <div class="likeness-row">
              <div class="sources">
                <img src={row.survivor.src} srcset={row.survivor.srcset} sizes={ROW_SIZES} alt={sampleAlt(row.pair, "survivor")} width="720" height="960" loading="lazy" decoding="async" />
                <img src={row.infected.src} srcset={row.infected.srcset} sizes={ROW_SIZES} alt={sampleAlt(row.pair, "infected")} width="720" height="960" loading="lazy" decoding="async" />
              </div>
              <span class="arrow scene" aria-hidden="true">→</span>
              <img class="frame" src={row.a.src} srcset={row.a.srcset} sizes={ROW_SIZES} alt={sampleAlt(row.pair, "A")} width="720" height="1280" loading="lazy" decoding="async" />
              <img class="frame warm" src={row.c.src} srcset={row.c.srcset} sizes={ROW_SIZES} alt={sampleAlt(row.pair, "C")} width="720" height="1280" loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
        <p class="fine">{t("story.sample", {}, locale)}</p>
      </div>
    </section>
  )
}


{
  variant === "home" && d.tips && (
    <section class="section tips-section">
      <div class="wrap tips-grid">
        <div>
          <h2>{t("home.tips.title", {}, locale)}</h2>
        </div>
        <div>
          <p class="scene">{t("home.tips.good", {}, locale)}</p>
          <ul class="lines">{d.tips.good.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div>
          <p class="scene">{t("home.tips.avoid", {}, locale)}</p>
          <ul class="lines avoid">{d.tips.avoid.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </section>
  )
}

{
  d.steps && (
    <section class="section steps-section">
      <div class="wrap">
        <h2>{t("home.steps.title", {}, locale)}</h2>
        <ol class="steps">
          {d.steps.map((step, i) => (
            <li>
              <span class="step-n scene">{`0${i + 1}`}</span>
              <div>
                <h3>{step.title}</h3>
                <p class="muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  variant === "home" && (
    <section class="section pricing-band">
      <div class="wrap pricing-grid">
        <div>
          <p class="scene">INT. BOX OFFICE — NIGHT</p>
          <h2>{t("home.pricing.title", {}, locale)}</h2>
          <p class="lede">{t("home.pricing.text", {}, locale)}</p>
          <a href="/pricing">{t("home.pricing.more", {}, locale)}</a>
        </div>
        <PackRows client:visible returnPath="/#make" />
      </div>
    </section>
  )
}

{
  d.compare && (
    <section class="section compare">
      <div class="wrap">
        <h2>{d.compare.title}</h2>
        {d.compare.intro && <p class="lede">{d.compare.intro}</p>}
        <div class="compare-table" role="table">
          <div class="compare-row head" role="row">
            <span role="columnheader">{t("home.compare.way", {}, locale)}</span>
            <span role="columnheader">{t("home.compare.how", {}, locale)}</span>
            <span role="columnheader">{t("home.compare.catch", {}, locale)}</span>
          </div>
          {d.compare.rows.map((row, i) => (
            <div class={`compare-row${i === d.compare!.rows.length - 1 ? " ours" : ""}`} role="row">
              <span role="cell">{row.way}</span>
              <span role="cell">{row.how}</span>
              <span role="cell">{row.catch}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  variant === "home" && d.pet && (
    <section class="section pet-band">
      <div class="wrap pet-grid">
        <div>
          <p class="scene">EXT. BACKYARD — DUSK</p>
          <h2>{d.pet.title}</h2>
          <p class="lede">{d.pet.text}</p>
          <a class="btn btn-lg" href="/pet-zombie-video">{t("home.pet.cta", {}, locale)}</a>
        </div>
        <video
          class="pet-clip"
          src={filmLoop("pet")}
          poster={petPoster.src}
          muted
          loop
          autoplay
          playsinline
          preload="none"
          width="360"
          height="640"
          aria-label={`AI example: ${samplePair("q01")?.who ?? ""}`}
        />
      </div>
    </section>
  )
}

<section class="section">
  <div class="wrap prose long-read">
    <Content components={{ F }} />
  </div>
</section>

{
  d.faq && d.faq.length > 0 && (
    <section class="section faq-section">
      <div class="wrap">
        <h2>{t("home.faq.title", {}, locale)}</h2>
        <Faq items={d.faq} />
      </div>
    </section>
  )
}

{
  d.closing && (
    <section class="closing">
      <div class="wrap closing-card">
        <p class="tc-line">{d.closing.title}</p>
        <p class="tc-names">{t("story.title.namesPlaceholder", {}, locale)} · {t("home.closing.since", {}, locale)}</p>
        <p class="lede">{d.closing.text}</p>
        <a class="btn btn-primary btn-lg" href="#make">{t("home.cta", {}, locale)}</a>
      </div>
    </section>
  )
}
