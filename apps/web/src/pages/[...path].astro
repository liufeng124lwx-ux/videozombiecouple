---
import { render } from "astro:content";
import { indexable, pageById, pagePath } from "@vzc/catalog";
import F from "../components/F.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageContent } from "../lib/content.ts";
import { BUILD_NOW, homeHero } from "../lib/home.ts";
import { type RouteProps, staticPaths } from "../lib/routes.ts";
import { sampleImage } from "../lib/sample-images.ts";
import { filmPoster, filmSrc, type SampleFilm } from "../lib/samples.ts";
import { alternateLinks, ogImagePath, pageSchemas } from "../lib/seo.ts";
import { absoluteUrl, buildMode } from "../lib/site.ts";
import { heroFilm, sampleVideo, storyFilms } from "../lib/story-landing.ts";
import AccountPage from "../templates/AccountPage.astro";
import BlogPage from "../templates/BlogPage.astro";
import HomePage from "../templates/HomePage.astro";
import LandingPage from "../templates/LandingPage.astro";
import LegalPage from "../templates/LegalPage.astro";
import PhotoPage from "../templates/PhotoPage.astro";
import PricingPage from "../templates/PricingPage.astro";
import StoryPage from "../templates/StoryPage.astro";

export function getStaticPaths() {
  return staticPaths(buildMode());
}

const { pageId, locale, draft } = Astro.props as RouteProps;
const page = pageById(pageId);
if (!page) throw new Error(`Unknown page ${pageId}`);
const path = pagePath(page, locale);
const h1 = page.locales[locale]?.h1 ?? "";
const entry = await pageContent(page, locale, draft);
const Content = entry ? (await render(entry)).Content : null;
const noindex = !indexable({ page, locale, path, draft }, buildMode());
const url = absoluteUrl(path);
// Sample films described as VideoObjects: a story page's films, or the home page's featured film.
const videoFilms: SampleFilm[] =
  page.kind === "home"
    ? [homeHero(BUILD_NOW).film]
    : page.kind === "landing"
      ? storyFilms(page.preset?.story ?? "zombie")
      : [];
const videos = await Promise.all(
  videoFilms.map(async (film) => ({
    ...sampleVideo(film),
    contentUrl: absoluteUrl(filmSrc(film.id)),
    thumbnailUrl: absoluteUrl((await sampleImage(filmPoster(film.id), "540px", [540])).src),
  })),
);
const schemas = pageSchemas({
  kind: page.kind,
  h1,
  url,
  homeUrl: absoluteUrl("/"),
  image: absoluteUrl(ogImagePath(locale, page.id)),
  content: entry?.data ?? null,
  story: page.preset?.story,
  videos,
});
const links = alternateLinks(page, buildMode(), absoluteUrl);
// Start the hero film's poster with the HTML, not after the stylesheets (LCP on phones).
const HERO_POSTER_SIZES = "(min-width: 900px) 380px, 86vw";
// The home page's film is the featured story's (decided at build time, like the page itself).
const heroId =
  page.kind === "home"
    ? homeHero(BUILD_NOW).film.id
    : page.kind === "landing"
      ? heroFilm(entry?.data.film, page.preset?.story ?? "zombie").id
      : null;
const hero = heroId ? await sampleImage(filmPoster(heroId), HERO_POSTER_SIZES, [540]) : null;
---
<BaseLayout
  title={entry?.data.title ?? `${h1} (draft) | VideoZombieCouple`}
  description={entry?.data.description ?? h1}
  path={path}
  locale={locale}
  noindex={noindex}
  alternates={links}
  schemas={schemas}
  ogImage={ogImagePath(locale, page.id)}
  page={page}
>
  {
    hero && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={hero.src}
        imagesrcset={hero.srcset}
        imagesizes={HERO_POSTER_SIZES}
        fetchpriority="high"
      />
    )
  }
  {
    page.kind === "home" && entry ? (
      <HomePage locale={locale} h1={h1} entry={entry} />
    ) : page.kind === "landing" && entry ? (
      <LandingPage locale={locale} h1={h1} page={page} entry={entry} />
    ) : page.kind === "photo" && entry ? (
      <PhotoPage locale={locale} h1={h1} entry={entry} />
    ) : page.kind === "story" ? (
      <StoryPage locale={locale} h1={h1} />
    ) : page.kind === "pricing" && entry ? (
      <PricingPage locale={locale} h1={h1} entry={entry} />
    ) : page.kind === "account" ? (
      <AccountPage locale={locale} h1={h1} />
    ) : page.kind === "legal" && entry ? (
      <LegalPage locale={locale} h1={h1} entry={entry} />
    ) : page.kind === "blog" && entry ? (
      <BlogPage locale={locale} h1={h1} entry={entry} />
    ) : (
      <div class="wrap prose">
        <h1>{h1}</h1>
        {Content && <Content components={{ F }} />}
      </div>
    )
  }
</BaseLayout>
